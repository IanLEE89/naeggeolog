{
  "name": "naeggeolog-css",
  "private": true,
  "scripts": {
    "build": "tailwindcss -i ./app.src.css -o ../assets/app.css --minify",
    "watch": "tailwindcss -i ./app.src.css -o ../assets/app.css --watch",
    "build:js": "node build-js.mjs",
    "build:all": "npm run build && npm run build:js"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.0",
    "tailwindcss": "^4.1.0",
    "esbuild": "^0.25.0"
  },
  "dependencies": {
    "@tiptap/core": "^2.11.0",
    "@tiptap/pm": "^2.11.0",
    "@tiptap/starter-kit": "^2.11.0",
    "@tiptap/extension-underline": "^2.11.0",
    "@tiptap/extension-link": "^2.11.0",
    "@tiptap/extension-text-style": "^2.11.0",
    "@tiptap/extension-color": "^2.11.0",
    "@tiptap/extension-placeholder": "^2.11.0",
    "photoswipe": "^5.4.4",
    "@googlemaps/markerclusterer": "^2.5.3"
  }
}